[Unit]
Description=MintKit Launcher
After=multi-user.target
DefaultDependencies=no
Conflicts=rescue.service rescue.target

[Service]
Environment=SDL_AUDIODRIVER=dummy
Environment=SDL_VIDEODRIVER=offscreen
Environment=TZ=America/Chicago
Type=simple
User=mintkit
WorkingDirectory=/home/mintkit
Environment=HOME=/home/mintkit
Environment=MINTKIT_DATA=/home/mintkit/.mintkit
Environment=PYTHONPATH=/home/mintkit
ExecStart=/usr/bin/python3 /home/mintkit/launcher/mintos.py
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target